<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoundCloudRPC"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SoundCloudLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudRPC.Settings" />

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudRPC" />

        <activity
            android:name=".NowPlayingActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudRPC" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:theme="@style/Theme.SoundCloudRPC.Settings" />

        <activity
            android:name=".DiscordLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudRPC.Settings" />

        <activity
            android:name=".PlaylistTracksActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudRPC" />

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudRPC" />

        <activity
            android:name=".ChangelogActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudRPC" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.SoundCloudRPC" />

        <service
            android:name=".RpcService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".PlayerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
